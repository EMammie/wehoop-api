{
  "name": "wehoop-api",
  "version": "0.1.0",
  "description": "Backend for Wehoop: women's basketball live stats (WNBA, NCAAWB, Unrivaled) on Sportradar data",
  "scripts": {
    "check": "biome ci . && tsc --noEmit && vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "VITEST_INTEGRATION=1 vitest run",
    "invariants": "tsx src/bin/invariants.ts",
    "dev:api": "tsx watch src/bin/api.ts",
    "dev:worker": "tsx src/bin/worker.ts",
    "sim": "tsx src/bin/sim.ts",
    "subscribe": "tsx src/bin/subscribe.ts",
    "build": "tsc -p tsconfig.json --outDir dist",
    "release:tag": "tsx src/bin/release-tag.ts",
    "supabase": "supabase"
  },
  "author": "EMammie",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "pino-pretty": "^13.2.0",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.6"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
