# ---- Environments (see CLAUDE.md "Environments") ------------------------------
# .env            sim mode against the DEV stack (`pnpm supabase start`, db 54322). Nothing in
#                 here may be a real Sportradar key. Loaded by the `*:live` and `*:rehearsal`
#                 scripts FIRST; the second file below overrides it.
# .env.trial      git-ignored, chmod 600, real trial keys. Loaded only by `pnpm trial:live`,
#                 `pnpm preflight:live`, `pnpm worker:live`, `pnpm api:live`
#                 (node --env-file=.env --env-file=.env.trial). It MUST point every database
#                 variable at the persistent TRIAL stack (`pnpm trial:db start`, +1000 ports),
#                 because `supabase db reset` / `pnpm test:int` erase the dev stack and with it
#                 the quota ledger while Sportradar keeps counting:
#                   MODE=trial
#                   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
#                   DATABASE_SESSION_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
#                   SUPABASE_URL=http://127.0.0.1:55321
#                   SUPABASE_ANON_KEY=<anon key printed by `pnpm trial:db status`>
#                   SUPABASE_SERVICE_ROLE_KEY=<service role key printed by `pnpm trial:db status`>
#                   SPORTRADAR_NCAAWB_KEY=<console>
#                   SPORTRADAR_BASE_URL=            (unset: the real host)
#                   QUOTA_NCAAWB=                   (blank: the verified database values rule)
#                   DEVLOG_BUFFER=0
# .env.rehearsal  git-ignored, FAKE keys, loopback host (`pnpm sim serve`); see .env.rehearsal.example.
# Exported shell variables override both files: `unset` stale exports before switching.
# Before any live run: `pnpm preflight:live` must exit 0.

# ---- Runtime mode -----------------------------------------------------------
# sim        : Sportradar simulations (playback.sportradar.com), no API key, never counts quota
# trial      : Sportradar trial keys, manual game selection, budget reservations enforced
# production : Sportradar production keys, automatic scheduling, push feeds (the worker runs the
#              scheduler without --game: daily schedule polls + coverage-aware watches in push mode;
#              docs/DEPLOY.md lists the Fly secrets, all of them variables from this file)
MODE=sim
LOG_LEVEL=info
NODE_ENV=development

# ---- Postgres (Supabase) ----------------------------------------------------
# Pooled connection for ordinary queries (transaction mode is fine).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct / session-mode connection for the worker's advisory lock and LISTEN.
# Locally this is the same URL. On Supabase cloud use the DIRECT connection or the
# SESSION pooler (port 5432), never the transaction pooler (port 6543): config
# refuses 6543 / pgbouncer=true, and requires this variable outside MODE=sim.
DATABASE_SESSION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Supabase API (Realtime Broadcast publisher + anon auth tests) ----------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sportradar -------------------------------------------------------------
# One key per API product. Leave empty in sim mode.
SPORTRADAR_WNBA_KEY=
SPORTRADAR_NCAAWB_KEY=
SPORTRADAR_UNRIVALED_KEY=
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_PLAYBACK_URL=https://playback.sportradar.com
# Production/trial API host. Leave unset. Only a local rehearsal (`pnpm sim serve`)
# points it at http://127.0.0.1:8787: the override must be a loopback host (127.0.0.1,
# localhost, ::1; the key is sent to it), is refused when MODE=production, and makes every
# call / run / reservation `source = rehearsal` (rate-limited, never quota-counted).
SPORTRADAR_BASE_URL=

# ---- Quota (trial / production only; sim and fixture calls never count) -------
# Console limits per product as "<limit_30d>[/<reserve>]" (e.g. 1000/100). When set,
# QuotaGuard uses these instead of ingest.product_quotas and treats the product as
# verified. Otherwise run `pnpm trial quota --product ncaawb --limit-30d N` after
# reading the limit in the Sportradar console; the guard refuses every call while
# product_quotas.verified_at is null.
QUOTA_WNBA=
QUOTA_NCAAWB=
QUOTA_UNRIVALED=
# Ledger protection: MODE=trial|production refuses to start when DATABASE_URL (or the session
# URL) is the dev stack (127.0.0.1/localhost:54322), because `supabase db reset` would erase the
# quota ledger. A rehearsal (loopback SPORTRADAR_BASE_URL) is exempt. Set to 1 only to accept
# that loss knowingly (integration tests do).
TRIAL_ALLOW_DEV_DB=

# ---- API server -------------------------------------------------------------
PORT=3000
# Bearer for GET /v1/admin/quota (outbox + quota + reservations). Unset = route answers 503.
ADMIN_BEARER_TOKEN=
# Where `pnpm subscribe` finds the snapshot / changes endpoints (default http://127.0.0.1:$PORT).
API_BASE_URL=

# ---- Crash-point fault injection (M1 evidence only; refused in production) ----
# before_commit[:seq]  SIGKILL the worker inside applyChanges after every write of a
#                      batch has been issued but before COMMIT, once last_seq reaches seq.
# after_publish[:seq]  SIGKILL the worker in the outbox publisher after the HTTP
#                      broadcast succeeded and before published_at is written.
# Example: WEHOOP_FAULT=before_commit:120
WEHOOP_FAULT=

# ---- Devlog -----------------------------------------------------------------
DEVLOG_BUFFER=0
DEVLOG_BUFFER_ACCOUNT=
DEVLOG_BUFFER_GROUP=To Do
