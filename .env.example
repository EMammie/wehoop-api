# ---- Runtime mode -----------------------------------------------------------
# sim        : Sportradar simulations (playback.sportradar.com), no API key, never counts quota
# trial      : Sportradar trial keys, manual game selection, budget reservations enforced
# production : Sportradar production keys, automatic scheduling, push feeds
MODE=sim
LOG_LEVEL=info
NODE_ENV=development

# ---- Postgres (Supabase) ----------------------------------------------------
# Pooled connection for ordinary queries (transaction mode is fine).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct / session-mode connection for the worker's advisory lock and LISTEN.
# Locally this is the same URL. On Supabase cloud use the DIRECT connection or the
# SESSION pooler (port 5432), never the transaction pooler (port 6543): config
# refuses 6543 / pgbouncer=true, and requires this variable outside MODE=sim.
DATABASE_SESSION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Supabase API (Realtime Broadcast publisher + anon auth tests) ----------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sportradar -------------------------------------------------------------
# One key per API product. Leave empty in sim mode.
SPORTRADAR_WNBA_KEY=
SPORTRADAR_NCAAWB_KEY=
SPORTRADAR_UNRIVALED_KEY=
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_PLAYBACK_URL=https://playback.sportradar.com

# ---- API server -------------------------------------------------------------
PORT=3000
ADMIN_BEARER_TOKEN=
# Where `pnpm subscribe` finds the snapshot / changes endpoints (default http://127.0.0.1:$PORT).
API_BASE_URL=

# ---- Crash-point fault injection (M1 evidence only; refused in production) ----
# before_commit[:seq]  SIGKILL the worker inside applyChanges after every write of a
#                      batch has been issued but before COMMIT, once last_seq reaches seq.
# after_publish[:seq]  SIGKILL the worker in the outbox publisher after the HTTP
#                      broadcast succeeded and before published_at is written.
# Example: WEHOOP_FAULT=before_commit:120
WEHOOP_FAULT=

# ---- Devlog -----------------------------------------------------------------
DEVLOG_BUFFER=0
DEVLOG_BUFFER_ACCOUNT=
DEVLOG_BUFFER_GROUP=To Do
