# Rehearsal environment: `cp .env.rehearsal.example .env.rehearsal` (git-ignored).
# Loaded AFTER .env by `pnpm trial:rehearsal`, `pnpm preflight:rehearsal`, `pnpm worker:rehearsal`,
# `pnpm api:rehearsal` (node --env-file=.env --env-file=.env.rehearsal), so the database stays the
# dev stack from .env and only these keys change. Every value here is made up: the loopback host is
# `pnpm sim serve --replay-file fixtures/ncaawb/sim-d9b71fe0-replay.compact.jsonl.gz --speed 60 --port 8787`,
# which accepts any x-api-key. Calls are `source = rehearsal`: rate-limited, never quota-counted.
MODE=trial
SPORTRADAR_NCAAWB_KEY=fake-ncaawb-key
SPORTRADAR_WNBA_KEY=fake-wnba-key
SPORTRADAR_UNRIVALED_KEY=
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_BASE_URL=http://127.0.0.1:8787
# Blank on purpose: the database's verified values (pnpm trial:rehearsal quota ...) rule.
QUOTA_WNBA=
QUOTA_NCAAWB=
QUOTA_UNRIVALED=
TRIAL_ALLOW_DEV_DB=
DEVLOG_BUFFER=0
